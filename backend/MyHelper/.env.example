DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# 复制为 .env 并填写；不要提交真实密钥。
AI_API_KEY=replace-with-your-gemini-api-key
# 包含 /v1beta/openai/，不要追加 /chat/completions。
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 填写你的账号实际可用的模型 ID。
AI_MODEL=replace-with-your-model-id
# 本地上传 Markdown 建立知识索引时，将以下开关设为 true，并配置 AI_EMBEDDING_PROVIDER=openai。
# 上传接口无鉴权，仅限本地或受保护的测试环境启用。
KNOWLEDGE_ENABLED=true
KNOWLEDGE_UPLOAD_ENABLED=true
KNOWLEDGE_DEBUG_ENABLED=true
# 调试接口默认写入后端模块的 docs/addition/vectorStoreOutput.md；可指定其他路径。
# KNOWLEDGE_DEBUG_OUTPUT_PATH=/absolute/path/vectorStoreOutput.md
AI_EMBEDDING_PROVIDER=openai
# 这里填模型 ID；openai 是上面的协议提供方，不是模型 ID。
AI_EMBEDDING_MODEL=BAAI/bge-m3
# 示例：硅基流动（兼容OpenAI格式）
AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 推荐中英文通用强模型
AI_EMBEDDING_API_KEY=
CHAT_MAX_INPUT_TOKENS=10240
