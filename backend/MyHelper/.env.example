DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USERNAME=root
DB_PASSWORD=
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# 复制为 .env 并填写；不要提交真实密钥。
AI_API_KEY=replace-with-your-gemini-api-key
# 包含 /v1beta/openai/，不要追加 /chat/completions。
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 填写你的账号实际可用的模型 ID。
AI_MODEL=replace-with-your-model-id
AI_EMBEDDING_MODEL=replace-with-your-embedding-model-id
# 可选：聊天请求的估算输入上限，默认 8192；不限制模型输出。
CHAT_MAX_INPUT_TOKENS=10240
